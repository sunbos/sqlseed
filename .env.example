# sqlseed environment variables
# Copy this file to .env and adjust values as needed.

# ─── Logging ─────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
SQLSEED_LOG_LEVEL=INFO

# ─── Cache ───────────────────────────────────────────────
# Cache directory for AI configs and snapshots
# Default: platform-specific (~/.cache/sqlseed on Linux, ~/Library/Caches/sqlseed on macOS, %LOCALAPPDATA%/sqlseed on Windows)
# SQLSEED_CACHE_DIR=

# ─── AI Plugin (sqlseed-ai) ──────────────────────────────
# API key (required for AI features)
# Falls back to OPENAI_API_KEY if not set
# SQLSEED_AI_API_KEY=

# API base URL (auto-detected by backend)
# SQLSEED_AI_BASE_URL=

# Model name (default: gemma-4-26b-a4b-it for google_ai_studio)
# SQLSEED_AI_MODEL=

# API timeout in seconds (default: 60 for cloud, 120 for local)
# SQLSEED_AI_TIMEOUT=

# AI backend: google_ai_studio, lm_studio, ollama, openai_compat
SQLSEED_AI_BACKEND=google_ai_studio

# Google AI Studio API key (required when backend is google_ai_studio)
# GOOGLE_API_KEY=

# ─── OpenAI Compatibility ────────────────────────────────
# Used as fallback for SQLSEED_AI_API_KEY
# OPENAI_API_KEY=

# Used as fallback for SQLSEED_AI_BASE_URL
# OPENAI_BASE_URL=
