# CodeFlow's documented configuration entry point is a repository-root .pylintrc:
# https://www.getcodeflow.com/pylint-configuration.html
# Mirror the existing message policy in pyproject.toml; check environment
# adaptation separately without broadening message or source exclusions.
# CodeFlow reports Pylint 2.17.7, which predates R0917 (introduced in 3.3).
# The modern configuration retains that rule's existing policy and is selected
# with pylint --rcfile=pyproject.toml. Default discovery prefers this file.
# tests/test_codeflow_config.py guards shared policy and import boundaries.

[MAIN]
# The observed CodeFlow analysis cannot resolve declared dependencies. Resolve
# the five local source trees and pytest's importlib namespaces from the
# repository root without importing project code or running installers.
source-roots=
    src,
    plugins/sqlseed-cli/src,
    plugins/sqlseed-ai/src,
    plugins/mcp-server-sqlseed/src,
    plugins/sqlseed-web/src,
    .
# Direct-file script imports resolve their own helpers before third-party names
# such as build. Keep these search paths out of source-roots so package-mode
# relative imports retain their scripts/examples namespace.
init-hook=import sys; sys.path[:0] = ['src', 'plugins/sqlseed-cli/src', 'plugins/sqlseed-ai/src', 'plugins/mcp-server-sqlseed/src', 'plugins/sqlseed-web/src', '.', 'scripts/complex_validation', 'examples/scenario_lab', 'examples']

# Only declared third-party imports and Windows' msvcrt may be unavailable.
# tests/test_codeflow_config.py checks manifest/CI-lock or platform-stdlib
# provenance and rejects internal collisions; import-error remains enabled.
ignored-modules=
    click,
    docker,
    faker,
    fastapi,
    httpx,
    hypothesis,
    mcp,
    msvcrt,
    openai,
    packaging,
    pluggy,
    pydantic,
    pytest,
    pywintypes,
    requests,
    rich,
    rstr,
    simpleeval,
    sqlalchemy,
    sqlglot,
    starlette,
    structlog,
    testcontainers,
    tomli,
    tqdm,
    typing_extensions,
    uvicorn,
    winerror,
    yaml

# Preserve the extension checkers observed in CodeFlow's 5b0dd07 analysis.
# A custom rc file must not silently drop their findings. The published service
# defaults do not explain how these plugins are loaded, so keep them explicit.
# https://pylint.pycqa.org/en/v2.17.7/user_guide/checkers/extensions.html
load-plugins=
    pylint.extensions.bad_builtin,
    pylint.extensions.code_style,
    pylint.extensions.docparams,
    pylint.extensions.mccabe,
    pylint.extensions.overlapping_exceptions,
    pylint.extensions.redefined_variable_type,
    pylint.extensions.set_membership

[FORMAT]
max-line-length=120

[BASIC]
good-names-rgxs=^(dw|ull|cb|lp|h|sz|p|l|w|b|n)[A-Z][a-zA-Z0-9]*$

[DESIGN]
# Preserve the service's existing limits from its 5b0dd07 findings:
# too-many-return-statements (36/11), too-many-statements (964/100),
# and too-many-branches (358/27). These are not new threshold increases.
max-returns=11
max-statements=100
max-branches=27

[MESSAGES CONTROL]
# These are the existing project exclusions, not new CodeFlow-specific ones.
# The rationale for each setting remains alongside the modern configuration.
disable=
    import-outside-toplevel,
    unnecessary-ellipsis,
    unused-argument,
    assignment-from-no-return,
    abstract-method,
    duplicate-code,
    too-many-arguments,
    wrong-import-order,
    unused-import,
    import-self,
    too-many-locals,
    too-few-public-methods,
    too-many-instance-attributes,
    missing-function-docstring,
    missing-class-docstring,
    missing-module-docstring,
    protected-access,
    attribute-defined-outside-init,
    too-many-public-methods,
    invalid-name,
    too-many-lines,
    not-callable,
    unexpected-keyword-arg,
    no-value-for-parameter,
    no-member
